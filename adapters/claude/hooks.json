{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/adapters/claude/compose.py\" session-start"}
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "crustify:.*",
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/adapters/claude/transcripts.py\""}
        ]
      }
    ]
  }
}
